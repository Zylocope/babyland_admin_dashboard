# Copy to .env and set your backend URL.
VITE_APP_BASE_URL=https://appleland-backend-1.onrender.com

# AI assistant. Server-side only — no VITE_ prefix, so it is never bundled into the client.
# Get a key at https://aistudio.google.com/apikey and set the same var in Vercel project settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_CAP=200
